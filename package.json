{
  "name": "meteor-devtools-evolved",
  "version": "2.0.0",
  "description": "Meteor DevTools Evolved",
  "repository": "https://github.com/leonardoventurini/meteor-devtools-evolved",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=26.5.1 <27"
  },
  "keywords": [
    "meteor",
    "ddp",
    "devtools"
  ],
  "scripts": {
    "setup": "yarn install && cd devapp-3.5 && meteor npm install && cd ../devapp-2.16 && meteor npm install",
    "devapp": "node scripts/run-development.mjs app",
    "devapp:2": "node scripts/run-development.mjs app:2",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv2",
    "validate:chrome": "node scripts/validate-build.mjs chrome",
    "validate:firefox": "node scripts/validate-build.mjs firefox",
    "validate:builds": "yarn validate:chrome && yarn validate:firefox",
    "dev:chrome": "node scripts/run-development.mjs chrome",
    "dev:firefox": "node scripts/run-development.mjs firefox",
    "dev": "yarn dev:chrome",
    "clean": "wxt clean",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs devapp-3.5",
    "test:e2e:meteor2": "node scripts/run-e2e.mjs devapp-2.16",
    "test:e2e:all": "node scripts/run-e2e.mjs devapp-3.5 devapp-2.16",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tests/e2e/tsconfig.json && tsc --noEmit --project tsconfig.playground.json",
    "audit": "yarn npm audit --recursive --environment production --severity high",
    "audit:all": "yarn npm audit --recursive --severity high",
    "audit:devapp": "npm audit --prefix devapp-3.5 --audit-level high"
  },
  "author": "Leonardo Venturini",
  "license": "MIT",
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@heroicons/react": "^2.2.0",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "classnames": "^2.5.1",
    "daisyui": "^5.7.22",
    "dexie": "^4.4.5",
    "lodash.debounce": "^4.0.8",
    "lodash.memoize": "^4.1.2",
    "lodash.sortby": "^4.7.0",
    "lodash.throttle": "^4.1.1",
    "luxon": "^3.7.2",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "normalize.css": "8.0.1",
    "polished": "^4.3.1",
    "pretty-bytes": "^7.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-window": "^2.3.0",
    "react-window-infinite-loader": "^2.0.1",
    "sass": "^1.103.1",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "26.5.1",
    "yarn": "4.12.0"
  },
  "resolutions": {
    "@babel/runtime@npm:^7.5.5": "^7.29.7",
    "@babel/runtime@npm:^7.8.7": "^7.29.7",
    "@babel/runtime@npm:^7.16.7": "^7.29.7",
    "@isaacs/brace-expansion": "^5.0.1",
    "ajv@npm:^8.0.0": "^8.20.0",
    "ajv@npm:^8.9.0": "^8.20.0",
    "axios": "^1.20.0",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "fast-json-patch": "^3.1.1",
    "fast-uri@npm:^3.0.1": "3.1.5",
    "flatted": "^3.4.4",
    "form-data": "^4.0.6",
    "http-cache-semantics": "^4.1.1",
    "ip-address": "^10.7.0",
    "js-yaml@npm:^4.1.0": "4.3.1",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.0",
    "jws": "^4.0.0",
    "loader-utils": "^3.2.1",
    "minimatch@npm:^3.0.4": "3.1.4",
    "minimatch@npm:^3.1.2": "3.1.4",
    "minimatch@npm:^10.1.1": "10.2.6",
    "node-forge": "^1.4.0",
    "picomatch": "^4.0.7",
    "qs": "^6.14.1",
    "semver": "^7.5.4",
    "sha.js": "^2.4.12",
    "tar": "^7.5.22",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@wxt-dev/module-react": "1.2.2",
    "concurrently": "^10.0.5",
    "eslint": "9",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "65.0.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "web-ext": "^10.6.0",
    "wxt": "0.21.4"
  }
}
