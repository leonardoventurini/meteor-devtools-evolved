{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["DOM", "ES2024", "ESNext.Collection"],
    "types": ["chrome", "node", "react", "react-dom"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/*.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
